{
  "name": "forma-builder",
  "version": "3.0.0",
  "description": "FORMA 3 — building constructor editor (three.js, Manifold).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "visual": "node scripts/pw.mjs --project=visual",
    "visual:accept": "node scripts/pw.mjs --project=visual --update-snapshots",
    "flows": "node scripts/pw.mjs --project=flows",
    "perf:app": "node scripts/perf-app.mjs",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@tarikjabiri/dxf": "2.9.0",
    "dxf": "5.3.1",
    "earcut": "3.2.4",
    "fflate": "0.8.3",
    "jspdf": "4.2.1",
    "manifold-3d": "3.5.4",
    "meshoptimizer": "1.3.0",
    "polygon-clipping": "0.15.7",
    "svg2pdf.js": "2.8.1",
    "three": "0.170.0",
    "three-mesh-bvh": "0.9.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.0.0",
    "@types/three": "0.170.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "web-ifc": "0.0.78"
  }
}
