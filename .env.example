# Copie para .env e preencha (Supabase → Project Settings → API Keys / Data API). Sem estas duas linhas o
# Oriel funciona só no navegador, sem contas, com tudo liberado.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Preços mostrados na janela de planos (os de verdade são os do Stripe).
VITE_PRO_PRICE_MONTH=R$ 49
VITE_PRO_PRICE_YEAR=R$ 490
# 1 só se a conta do Stripe tiver Pix Automático (não disponível para empresas sediadas no Brasil);
# junto com o segredo STRIPE_PIX=1 nas funções do Supabase.
VITE_PAYMENT_PIX=
