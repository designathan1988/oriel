# Copy to .env and fill in (Supabase → Project Settings → API Keys / Data API). Without these two lines
# Oriel works in the browser only, without accounts, with everything unlocked.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Prices shown in the plans dialog (the real ones are Stripe's).
VITE_PRO_PRICE_MONTH=R$ 49
VITE_PRO_PRICE_YEAR=R$ 490
# 1 only if the Stripe account has Pix Automático (not available to companies based in Brazil);
# together with the secret STRIPE_PIX=1 in the Supabase functions.
VITE_PAYMENT_PIX=
# Error monitoring of the production build (Sentry → Project Settings → Client Keys). Empty: nothing is sent.
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=oriel@3.0.0
